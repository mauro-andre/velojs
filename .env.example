# Example environment for this repository — copy to .env (gitignored) and fill.
# A value exported in the shell always wins over the file.

# --- Release script (scripts/new-release.sh) ---

# npm granular access token with "Read and write (stage only)" on the package:
# it stages the release and approves or rejects the staged version.
NPM_TOKEN=

# GitHub fine-grained token with Contents: Read and write on the repository:
# it creates the release (and the tag the releases API points at the HEAD).
GITHUB_TOKEN=

# --- Native telemetry (apps built with VeloJS; read by the framework at boot) ---

# The destination env is the trigger: set the file and/or the sink and the
# collection is on; leave both unset (or empty) and nothing exists — no default
# path, no dev magic. Values expand ~ and $VAR.
# VELO_TELEMETRY_FILE=$DATA_DIR/telemetry.jsonl
# VELO_TELEMETRY_SINK_URL=https://collector.example.com/ingest
# VELO_TELEMETRY_MAX_MB=10