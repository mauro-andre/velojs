# Credentials for scripts/new-release.sh — copy this file to .env (gitignored)
# and fill both keys. A value exported in the shell wins over the file.

# npm granular access token with "Read and write (stage only)" on the package:
# it stages the release and approves or rejects the staged version.
NPM_TOKEN=

# GitHub fine-grained token with Contents: Read and write on the repository:
# it creates the release (and the tag the releases API points at the HEAD).
GITHUB_TOKEN=