{
    "name": "@mauroandre/velojs",
    "version": "0.0.3",
    "type": "module",
    "description": "Fullstack web framework built on Hono + Preact with Vite-powered AST transforms",
    "keywords": [
        "framework",
        "fullstack",
        "hono",
        "preact",
        "vite",
        "ssr",
        "typescript"
    ],
    "author": "Mauro André Silva",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mauro-andre/velojs.git"
    },
    "homepage": "https://github.com/mauro-andre/velojs#readme",
    "bin": {
        "velojs": "bin/velojs.js"
    },
    "files": [
        "dist/",
        "bin/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "vite build --config vite.build.config.ts && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --rootDir src",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./hooks": {
            "types": "./dist/hooks.d.ts",
            "import": "./dist/hooks.js"
        },
        "./events": {
            "types": "./dist/events.d.ts",
            "import": "./dist/events.js"
        },
        "./cookie": {
            "types": "./dist/cookie.d.ts",
            "import": "./dist/cookie.js"
        },
        "./factory": {
            "types": "./dist/factory.d.ts",
            "import": "./dist/factory.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js"
        }
    },
    "dependencies": {
        "@babel/generator": "^7.28.5",
        "@babel/parser": "^7.28.5",
        "@babel/traverse": "^7.28.5",
        "@babel/types": "^7.28.5",
        "@hono/node-server": "^1.19.0",
        "@hono/vite-dev-server": "^0.25.0",
        "@preact/preset-vite": "^2.10.0",
        "@preact/signals": "^2.8.0",
        "hono": "^4.12.0",
        "preact": "^10.29.0",
        "preact-render-to-string": "^6.6.0",
        "vite": "^7.3.0",
        "wouter-preact": "^3.9.0"
    },
    "devDependencies": {
        "@testing-library/preact": "^3.2.4",
        "@types/babel__generator": "^7.27.0",
        "@types/babel__traverse": "^7.28.0",
        "@types/node": "^25.5.2",
        "jsdom": "^29.0.2",
        "typescript": "^6.0.2",
        "vitest": "^3.2.1"
    }
}
