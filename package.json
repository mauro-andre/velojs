{
  "name": "velojs",
  "version": "1.0.0",
  "description": "Full-stack framework with Server Actions, SSR and Signals. The productivity of React Router v7 with the flexibility of Hono and the lightness of Preact.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./dev": {
      "types": "./dist/dev-server.d.ts",
      "import": "./dist/dev-server.js"
    }
  },
  "bin": {
    "velo": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauro-andre/velojs.git"
  },
  "keywords": [
    "framework",
    "fullstack",
    "ssr",
    "server-actions",
    "signals",
    "hono",
    "preact",
    "vite",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mauro-andre/velojs/issues"
  },
  "homepage": "https://github.com/mauro-andre/velojs#readme",
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@preact/signals": "^2.5.1",
    "hono": "^4.11.3",
    "preact": "^10.28.1",
    "preact-render-to-string": "^6.6.5",
    "wouter-preact": "^3.9.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.8",
    "@swc/types": "^0.1.25",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
