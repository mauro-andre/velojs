{
    "name": "@mauroandre/velojs",
    "version": "0.0.64",
    "type": "module",
    "description": "Fullstack web framework built on Hono + Preact with Vite-powered AST transforms",
    "keywords": [
        "framework",
        "fullstack",
        "hono",
        "preact",
        "vite",
        "ssr",
        "typescript"
    ],
    "author": "Mauro André Silva",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mauro-andre/velojs.git"
    },
    "homepage": "https://github.com/mauro-andre/velojs#readme",
    "bin": {
        "velojs": "bin/velojs.js"
    },
    "files": [
        "dist/",
        "bin/",
        "agent/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "vite build --config vite.build.config.ts && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --rootDir src",
        "build:agent": "vite-node scripts/build-skills.cli.ts",
        "prepack": "npm run build:agent",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:resumo": "vitest list --json > tests/resumo.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./hooks": {
            "types": "./dist/hooks.d.ts",
            "import": "./dist/hooks.js"
        },
        "./events": {
            "types": "./dist/events.d.ts",
            "import": "./dist/events.js"
        },
        "./sockets": {
            "types": "./dist/sockets.d.ts",
            "import": "./dist/sockets.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        },
        "./cookie": {
            "types": "./dist/cookie.d.ts",
            "import": "./dist/cookie.js"
        },
        "./factory": {
            "types": "./dist/factory.d.ts",
            "import": "./dist/factory.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js"
        }
    },
    "dependencies": {
        "@babel/generator": "^8.0.6",
        "@babel/parser": "^8.0.8",
        "@babel/traverse": "^8.0.7",
        "@babel/types": "^8.0.8",
        "@hono/node-server": "^1.19.17",
        "@hono/node-ws": "^1.3.0",
        "@hono/vite-dev-server": "^0.26.1",
        "@preact/preset-vite": "^2.10.0",
        "@preact/signals": "^2.8.0",
        "hono": "^4.12.0",
        "preact": "^10.29.8",
        "preact-render-to-string": "^6.6.0",
        "vite": "^8.3.5",
        "wouter-preact": "^3.9.0"
    },
    "devDependencies": {
        "@testing-library/preact": "^3.2.4",
        "@types/babel__generator": "^7.27.0",
        "@types/babel__traverse": "^7.28.0",
        "@types/node": "^26.6.6",
        "@types/ws": "^8.18.1",
        "jsdom": "^30.1.3",
        "typescript": "^7.0.2",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.12",
        "ws": "^8.21.3",
        "yaml": "^2.9.0"
    }
}
